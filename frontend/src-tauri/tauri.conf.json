{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "batchprint",
  "version": "0.1.0",
  "identifier": "com.batchprint.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build-only"
  },
  "app": {
    "windows": [
      {
        "title": "batchprint",
         "width": 1200,
         "height": 800,
         "resizable": false,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data: http://localhost:8000; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' blob:; connect-src 'self' blob: http://localhost:8000; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      },
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/backend-x86_64-pc-windows-msvc.exe"
    ]
  }
}
